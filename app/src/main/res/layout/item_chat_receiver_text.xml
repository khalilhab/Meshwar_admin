<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layoutDirection="rtl"
    android:layout_marginEnd="16dp">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_user"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:padding="@dimen/_1sdp"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/logo"
        app:shapeAppearanceOverlay="@style/RoundedOval"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorPrimary"/>

    <TextView
        android:id="@+id/txt_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@id/img_user"
        android:background="@drawable/corner2_3"
        android:gravity="center"
        android:minWidth="80dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textSize="@dimen/_10sdp"
        android:text="مرحبا عزيزي ،مرحبا عزيزي ،مرحبا" />

    <TextView
        android:id="@+id/tv_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt_message_text"
        android:layout_alignStart="@+id/txt_message_text"
        android:layout_gravity="bottom"
        android:layout_marginBottom="3dp"
        android:textColor="@color/colorHint"
        android:textSize="10dp"
        android:text="05:39 PM" />


</RelativeLayout>
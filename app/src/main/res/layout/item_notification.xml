<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_70sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/_12sdp"
    android:background="@drawable/corner_3"
    android:elevation="1dp">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_notify"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_29sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:src="@drawable/ic_notification2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/circle_alert"
        android:translationY="9dp"
        app:layout_constraintBottom_toTopOf="@+id/imv_notify"
        app:layout_constraintStart_toStartOf="@+id/imv_notify"
        app:layout_constraintTop_toTopOf="@id/imv_notify" />


    <TextView
        android:id="@+id/tv_driverAvailable"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_16sdp"
        android:ellipsize="end"
        android:text="منذ ساعة"
        android:textAlignment="viewStart"
        android:textColor="@color/colorHint2"
        android:layout_marginTop="@dimen/_12sdp"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_driverInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/_16sdp"
        android:text="السائق في الطريق إليك"
        android:layout_marginStart="@dimen/_8sdp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_black"
        android:textSize="@dimen/_11sdp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imv_notify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imv_notify"
        app:layout_constraintTop_toTopOf="@+id/imv_notify" />
</androidx.constraintlayout.widget.ConstraintLayout>
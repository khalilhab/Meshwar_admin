<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_70sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/corner_3"
    android:elevation="1dp">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_driver"
        android:layout_width="@dimen/_45sdp"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:src="@drawable/user1"
        android:layout_marginTop="@dimen/_9sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedOval" />


    <TextView
        android:id="@+id/tv_driverName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:text="@string/user1"
        android:fontFamily="@font/cairo_medium"
        android:textAlignment="viewStart"
        android:textColor="@color/text_black"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:textSize="@dimen/_13sdp"
        android:textStyle="normal"
        app:layout_constraintEnd_toStartOf="@id/tv_since"
        app:layout_constraintStart_toEndOf="@+id/imv_driver"
        app:layout_constraintTop_toTopOf="@+id/imv_driver" />


    <TextView
        android:id="@+id/tv_since"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        tools:text="منذ ساعة"
        android:textAlignment="viewStart"
        android:textColor="@color/colorAccent"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imv_driver" />

    <TextView
        android:id="@+id/tv_lasMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:text="@string/user1"
        app:layout_constraintEnd_toStartOf="@id/tv_since"
        android:layout_marginTop="@dimen/_3sdp"
        app:layout_constraintStart_toStartOf="@+id/tv_driverName"
        app:layout_constraintTop_toBottomOf="@+id/tv_driverName" />

</androidx.constraintlayout.widget.ConstraintLayout>
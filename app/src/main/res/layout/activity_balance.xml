<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.activities.balance.view.BalanceActivity">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutCompat2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_18sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_weight="1"
            android:text="@string/balance"
            android:textColor="@color/text_black"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold" />


        <ImageView
            android:id="@+id/imv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_16sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_back" />
    </androidx.appcompat.widget.LinearLayoutCompat>


    <TextView
        android:id="@+id/tv_accountBalanceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_balance"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:textColor="@color/text_black"
        android:textSize="@dimen/_12sdp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutCompat2" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_6"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_14sdp"
        android:orientation="vertical"
        android:backgroundTint="@color/green_trans"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_orderBalances"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:itemCount="3"
            android:layout_marginStart="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_18sdp"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_12sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            tools:listitem="@layout/item_order_balance"
            />

        <TextView
            android:id="@+id/tv_totalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_balance"
            android:layout_marginTop="@dimen/_8sdp"
            android:textColor="@color/text_black"
            android:textSize="@dimen/_13sdp"
            android:textStyle="normal"/>
        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="600 ريال"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:textColor="@color/text_black"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"/>


        <TextView
            android:id="@+id/tv_withdrawal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/balance_withdrawal"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="@color/text_black"
            android:visibility="gone"
            android:textSize="@dimen/_13sdp"
            android:textStyle="normal"/>

        <ImageView
            android:id="@+id/imv_visa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:visibility="gone"
            android:src="@drawable/visa_mastercard"
            />


    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
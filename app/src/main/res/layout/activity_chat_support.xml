<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    tools:context=".ui.activities.supportChat.view.ChatSupportActivity">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_driver"
        android:layout_width="@dimen/_45sdp"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginStart="@dimen/_12sdp"
        tools:src="@drawable/user1"
        android:layout_marginTop="@dimen/_9sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedOval" />


    <TextView
        android:id="@+id/tv_driverName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        tools:text="@string/user1"
        android:textAlignment="viewStart"
        android:textColor="@color/text_black"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:textSize="@dimen/_13sdp"
        android:textStyle="normal"
        app:layout_constraintEnd_toStartOf="@id/imv_back"
        app:layout_constraintStart_toEndOf="@+id/imv_driver"
        app:layout_constraintTop_toTopOf="@+id/imv_driver" />



    <RatingBar
        android:id="@+id/ratingBar"
        style="@style/Widget.AppCompat.RatingBar.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rating="3"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_3sdp"
        android:theme="@style/rating_bar"
        app:layout_constraintStart_toStartOf="@+id/tv_driverName"
        app:layout_constraintTop_toBottomOf="@+id/tv_driverName" />

    <ImageView
        android:id="@+id/imv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:padding="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="@+id/imv_driver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imv_driver" />



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_welcomeMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:cardElevation="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_24sdp"
        android:layout_marginEnd="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_70sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tv_contactDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:ellipsize="end"
                android:text="@string/welcome"
                android:drawablePadding="@dimen/_8sdp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_black"
                android:maxLines="1"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:ellipsize="end"
                android:text="@string/have_an_inquiry_or_questions_contact_us"
                android:textAlignment="viewStart"
                android:textColor="@color/text_black"
                android:maxLines="1"
                android:textSize="@dimen/_11sdp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_driverAvailable" />


            <TextView
                android:id="@+id/tv_firstMsg"
                android:layout_height="@dimen/_37sdp"
                android:layout_width="match_parent"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_9sdp"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:background="@drawable/btn_radius_3"
                app:layout_constraintVertical_bias="1"
                android:layout_marginBottom="@dimen/_28sdp"
                android:layout_marginTop="@dimen/_22sdp"
                android:text="@string/send_you_message"
                app:drawableStartCompat="@drawable/ic_send"
                app:drawableTint="@color/white" />



        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/tv_helpYou"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/we_are_here_to_help_you"
        android:textColor="@color/text_black"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imv_driver" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linear_chatContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_18sdp"
        android:background="@drawable/bg_bottom_sheet_dialog"
        android:elevation="@dimen/_2sdp"
        android:visibility="visible"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_helpYou">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_chats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_16sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/top_radius"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/imv_attachment"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="match_parent"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_add"
                android:visibility="visible" />

            <EditText
                android:id="@+id/ed_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/write_here"
                android:lineSpacingMultiplier=".6"
                android:maxHeight="@dimen/_42sdp"
                android:minHeight="@dimen/_36sdp"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:textSize="12sp" />


            <ImageView
                android:id="@+id/send"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="wrap_content"
                android:padding="@dimen/_6sdp"
                android:src="@drawable/ic_send"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/view" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>
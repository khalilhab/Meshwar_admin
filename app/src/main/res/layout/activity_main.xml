<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.main.view.MainActivity"
    android:background="@color/white"
    android:id="@+id/drawerLayout"
    android:fitsSystemWindows="true"
    >


<androidx.appcompat.widget.LinearLayoutCompat
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical">


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imv_menu"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:padding="@dimen/_3sdp"
            android:src="@drawable/ic_menu"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textAlignment="viewEnd"
            android:textSize="@dimen/_12sdp"
            android:text="@string/dashboard"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:background="@drawable/bg_grey_4"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:fontFamily="@font/cairo_semibold"
                android:layout_marginTop="@dimen/_18sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:text="@string/services"
                />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_18sdp"
                >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_orders"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/orders"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/orders"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Space
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_drivers"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/driver_app"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/drivers"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_18sdp"
                >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_cars"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/car"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/cars"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Space
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_balance"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/balance"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/balance"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:background="@drawable/bg_grey_4"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:fontFamily="@font/cairo_semibold"
                android:layout_marginTop="@dimen/_24sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:text="@string/messages"
                />


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_18sdp"
                >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_usersMsg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/message"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/clients"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Space
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_driversMsg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/message"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/drivers"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:background="@drawable/bg_grey_4"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:fontFamily="@font/cairo_semibold"
                android:layout_marginTop="@dimen/_24sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:text="@string/app_settings"
                />


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_18sdp"
                >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_terms_and_conditions"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/document"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/terms_and_conditions"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Space
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_locations"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_marker"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/locations"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/_25sdp"
                android:layout_marginTop="@dimen/_18sdp"
                >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_userPages"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/document"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/user_pages"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Space
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/linear_driverPages"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_80sdp"
                    android:background="@drawable/bg_green_4"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/document"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:fontFamily="@font/cairo_semibold"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        android:text="@string/driver_pages"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>



        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>



</androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        android:background="@drawable/bg_side_menu"
        >

        <include android:id="@+id/sideMenu"
            layout="@layout/side_menu"/>

    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
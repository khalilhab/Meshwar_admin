<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="@dimen/_200sdp"
    android:layout_marginStart="@dimen/_16sdp"
    android:layout_marginEnd="@dimen/_16sdp"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_user"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:src="@drawable/logo"
        android:layout_marginTop="@dimen/_4sdp"
        android:padding="@dimen/_1sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:visibility="visible"
        app:shapeAppearanceOverlay="@style/RoundedOval"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorPrimary"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_image_message"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/img_user"
        android:layout_marginStart="@dimen/_6sdp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/_4sdp"
        >

        <LinearLayout
            android:id="@+id/ly_image_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/corner2_3"
            android:gravity="center"
            android:layout_margin="@dimen/_3sdp"
            android:orientation="vertical"
            >

            <ImageView
                android:id="@+id/imv_message_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"
                android:layout_gravity="center_vertical"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_margin="@dimen/_7sdp"
                />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_margin="@dimen/_20sdp"
                android:visibility="visible"
                android:indeterminateTint="@color/colorAccent"

                />


        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/card_image_message"
        android:layout_alignEnd="@id/card_image_message"
        android:gravity="center"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_gravity="center"
        android:textColor="@color/colorHint"
        android:textSize="10dp"
        tools:text="05:39 PM" />


</RelativeLayout>
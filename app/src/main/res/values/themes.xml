<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BaseApplication" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:ignore="NewApi">false</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">true</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="background">@color/white</item>
        <!-- Customize your theme here. -->

        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>

        <item name="android:actionMenuTextColor">@color/colorPrimary</item>
        <!--        <item name="android:actionButtonStyle">@style/ActionButton</item>-->

        <item name="android:windowSplashScreenAnimationDuration" tools:ignore="NewApi">0</item>
    </style>



    <style name="StyleDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowAnimationStyle">@style/PauseDialogAnimation</item>
    </style>

    <style name="PauseDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>


    <!--inputLayout style-->
    <style name="textInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">@dimen/_3sdp</item>
        <item name="boxCornerRadiusTopEnd">@dimen/_3sdp</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/_3sdp</item>
        <item name="boxCornerRadiusBottomStart">@dimen/_3sdp</item>
        <item name="boxStrokeWidth">0.8dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/text_black</item>
        <item name="hintEnabled">true</item>
    </style>



    <style name="Theme.Transparent" parent="Theme.BaseApplication">
        <item name="android:background">#00000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#33000000</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
    <style name="Theme.CCP" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="android:background">@color/colorBg</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet_dialog</item>
    </style>

    <!-- Base application theme. -->
    <style name="ThemeStories" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="android:windowBackground">@color/colorDark</item>
        <item name="android:statusBarColor">#00000000</item>
    </style>

    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen2" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="btn" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginEnd">@dimen/_16sdp</item>
        <item name="android:layout_marginStart">@dimen/_16sdp</item>
        <item name="android:layout_height">@dimen/_38sdp</item>
        <item name="android:background">@drawable/btn_radius_3</item>
        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="picker" parent="Theme.AppCompat">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/_12sdp</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>

        <!-- Text color -->
        <item name="android:textColorPrimary">@color/colorDark</item>
        <!-- Divider color -->
        <item name="colorControlNormal">@color/colorLine</item>

    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/_12sdp</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="Spinner" parent="Widget.AppCompat.Light.DropDownItem.Spinner">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/colorDark</item>
        <item name="android:textSize">@dimen/_10sdp</item>

        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="StoriesProgressView">
        <item name="android:rotation">0</item>
    </style>

    <style name="RoundedSquare">
        <item name="cornerSize">8%</item>
    </style>

    <style name="RoundedSquare25">
        <item name="cornerSize">@dimen/_25sdp</item>
    </style>

    <style name="RoundedOval">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedTop">
        <item name="cornerSizeTopLeft">@dimen/_4sdp</item>
        <item name="cornerSizeTopRight">@dimen/_4sdp</item>
    </style>

    <style name="MineCustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="fontFamily">@font/cairo_regular</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="RoundedStart">
        <item name="cornerSizeTopLeft">@dimen/_4sdp</item>
        <item name="cornerSizeBottomLeft">@dimen/_4sdp</item>
    </style>

    <style name="RoundedSquare4">
        <item name="cornerSize">@dimen/_4sdp</item>
    </style>

    <style name="RoundedSquare8">
        <item name="cornerSize">@dimen/_8sdp</item>
    </style>

    <style name="rating_bar" parent="Theme.AppCompat">
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:progressBackgroundTint">#d9d9d9</item>
        <item name="colorControlNormal">#d9d9d9</item>
    </style>

    <style name="RoundedOval2">
        <item name="cornerSize">50%</item>
        <item name="strokeWidth">@dimen/_1sdp</item>
        <item name="strokeColor">@color/white</item>
    </style>

    <style name="AlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">@color/colorDark</item>
        <item name="android:textColorPrimary">@color/colorDark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--    <style name="ActionButton" parent="@android:style/Widget.ActionButton">-->
    <!--        <item name="android:drawablePadding">0dp</item>-->
    <!--        <item name="android:paddingStart">@dimen/_4sdp</item>-->
    <!--        <item name="android:paddingEnd">@dimen/_4sdp</item>-->
    <!--        <item name="android:minWidth">@dimen/_16sdp</item>-->
    <!--    </style>-->

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>